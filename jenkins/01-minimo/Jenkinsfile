// =============================================================================
// PASO 1 de 5 - Anatomía de un Jenkinsfile
// -----------------------------------------------------------------------------
// Qué agrega:    pipeline, agent, options, environment, stages y dos etapas: Checkout y Build.
// Concepto:      Pipeline como código (Jenkinsfile en el repo) y etapas 1 (Checkout) y 2 (Build) del curso.
// Qué se ve:     en la vista del job, Stage View muestra 2 columnas en verde. El build lo inicia solo el
//                polling del repositorio (cada minuto) después del commit.
// Cómo usarlo:  copiarlo sobre Jenkinsfile de turnos-api, commit en main y esperar el polling (ver README).
// =============================================================================

// Pipeline declarativo: todo el archivo vive dentro de un bloque pipeline { }.
// Es el pipeline como código: se versiona junto con la aplicación.
pipeline {
    // agent: dónde corre el pipeline. any = cualquier agente (nodo) libre; acá, el propio Jenkins con 2 executors.
    agent any

    // options: configuración general del pipeline.
    options {
        // Antepone la hora a cada línea del log (plugin Timestamper): permite ver cuánto tarda cada etapa.
        timestamps()
        // Si el build pasa de 60 minutos se aborta: un build colgado no debe ocupar el servidor para siempre.
        timeout(time: 60, unit: 'MINUTES')
        // Un solo build a la vez de este job: los demás esperan en cola. Evita que dos despliegues se pisen.
        disableConcurrentBuilds()
        // Desactiva el checkout automático del inicio: la etapa Checkout lo hace de forma explícita y visible.
        skipDefaultCheckout(true)
        // Conserva los últimos 10 builds (logs y artefactos) y borra los más viejos para no llenar el disco.
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    // environment: variables de entorno disponibles en todas las etapas (dentro de sh se leen como $NOMBRE).
    environment {
        // Limita el heap de la JVM de Maven a 384 MB para no agotar la VM de Docker de la laptop.
        MAVEN_OPTS = '-Xmx384m'
    }

    // stages: lista ordenada de etapas. Cada stage es una columna en Stage View.
    // Si una etapa falla, las siguientes no corren (fail early).
    stages {
        // Etapa 1 del curso: Checkout.
        stage('Checkout') {
            // steps: las acciones concretas de la etapa.
            steps {
                // checkout scm: baja el mismo repositorio y commit que contiene este Jenkinsfile (trazabilidad).
                // scm es la configuración de repositorio del job (la define casc.yaml).
                checkout scm
            }
        }

        // Etapa 2 del curso: Build. Maven arma el jar, el artefacto que se va a probar y empaquetar.
        stage('Build') {
            steps {
                // sh ejecuta un comando de shell en el agente. clean borra compilaciones previas (entorno limpio); package arma el jar.
                // -B: modo batch (log legible). -DskipTests: no corre los tests acá, tienen su propia etapa.
                sh 'mvn -B clean package -DskipTests'
            }
        }
    }

}
